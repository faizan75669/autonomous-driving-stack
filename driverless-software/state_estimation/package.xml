<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>state_estimation</name>
  <version>1.0.0</version>
  <description>EKF state estimation (odometry + IMU + GPS) for the FERN driverless car</description>
  <maintainer email="149727349+faizan75669@users.noreply.github.com">faizan75669</maintainer>
  <license>MIT</license>

